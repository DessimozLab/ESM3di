from pathlib import Path
import snakemake.utils

configfile: "config.yaml"

# -----------------------------------------------------------------------------
# Input Sequence Resolution
# -----------------------------------------------------------------------------
raw_input = Path(config.get("input_path", "data/test_virus_dataset/sequences.fasta"))

if raw_input.is_dir():
    fasta_extensions = {".fasta", ".fa", ".fas", ".fna", ".ffn", ".frn", ".aa", ".faa"}
    found_files = [f for f in raw_input.iterdir() if f.suffix.lower() in fasta_extensions]
    
    if len(found_files) == 1:
        raw_input = found_files[0]
        print(f"Directory provided. Using found FASTA file: {raw_input}")
    elif len(found_files) > 1:
        raise ValueError(
            f"Directory '{raw_input}' contains multiple FASTA files: {[f.name for f in found_files]}. "
            "Please specify the exact file path using -i/--input-fasta."
        )
    else:
        raise FileNotFoundError(f"No FASTA files found inside directory: {raw_input}")

if not raw_input.is_file():
    raise FileNotFoundError(f"Input sequence file not found: {raw_input}")

# Resolve absolute path and set dataset identifier
config["resolved_sequences"] = str(raw_input.resolve())
out_dir = Path(config.get("output_dir", "results"))
dataset = config.get("dataset") or raw_input.stem

# -----------------------------------------------------------------------------
# Target Rule
# -----------------------------------------------------------------------------
rule all:
    input:
        f"{out_dir}/{dataset}/foldtree_struct_tree.PP.nwk.rooted.final"

# -----------------------------------------------------------------------------
# Include Sub-Rules
# -----------------------------------------------------------------------------
include: "rules/database_ops.smk"
include: "rules/tree_building.smk"

