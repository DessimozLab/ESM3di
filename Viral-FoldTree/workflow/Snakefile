import os
import glob
import snakemake.utils

snakemake.utils.min_version("7.8.0")

# 1. Load Configurations
configfile: "config/config.yaml"

# 2. Global Workflow Variables
mattypes = ['foldtree']

import os
from glob import glob

# 1. Fallback default if the user forgot to set it in config.yaml
if "dataset" not in config or not config["dataset"]:
    config["dataset"] = "test_virus_dataset"

# 2. Dynamically look inside data/{dataset}/ for any .fasta, .fa, or .aa files

if config["sequences"] == "":
    dataset_dir = f"data/{config['dataset']}"
    found_sequences = []

    if os.path.exists(dataset_dir):
        # Scan the directory for common FASTA extensions
        found_sequences = [
            f for f in os.listdir(dataset_dir) 
            if f.endswith((".fasta", ".fa", ".fas", ".fna", ".ffn", ".frn", ".aa", ".faa"))
        ]

    # 3. Assign the target file name or handle errors gracefully
    if len(found_sequences) == 1:
        config["sequences"] = found_sequences[0]
    elif len(found_sequences) > 1:
        # If there are multiple fasta files, pick the first one but print a warning
        config["sequences"] = found_sequences[0]
        print(f"⚠️ WARNING: Multiple FASTA files found in {dataset_dir}. Using {config['sequences']}.")
    else:
        # Fallback name if the directory is empty or doesn't exist yet (prevents immediate crash during dry-runs)
        config["sequences"] = "sequences.fasta"

print(f"Using sequence file: {config['sequences']} for dataset: {config['dataset']}")
# 3. Target Rule (Defines the final outputs needed)
rule all:
    input:
        expand(
            "results/{dataset}/{mattype}_struct_tree.PP.nwk.rooted.final",
            dataset=config["dataset"],
            mattype=mattypes
        )

# 4. Include Rule Modules
include: "rules/database_ops.smk"
include: "rules/tree_building.smk"